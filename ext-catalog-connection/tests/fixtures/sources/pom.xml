<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      Two connectors of the tests of the connection framework: a stream and an API, in memory.
      Built by the build of the framework (mvn package, after the API of the contract is installed) into
      target/connector-sources-0.1.0.zip, which tests/global-setup.ts installs next to the framework.
    -->
    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-extension-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <groupId>org.example</groupId>
    <artifactId>connector-sources</artifactId>
    <version>0.1.0</version>
    <description>Two connectors of the tests of the connection framework: a stream and an API, in memory.</description>
    <properties>
        <extension.package.name>connector-sources</extension.package.name>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.mosaikit.ext</groupId>
            <artifactId>ext-catalog-connection-api</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.mosaikit</groupId>
            <artifactId>mosaikit-kernel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
