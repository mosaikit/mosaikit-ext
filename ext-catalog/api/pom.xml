<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      The API artifact of the contracts of the catalog (MK-134, EXT-105): only interfaces and records,
      which the catalog and every extension that implements one of its contracts bring as a library.
      The kernel loads it once, in the highest version of its major version, so the major version
      changes only when an old version of a contract is retired; a breaking change of a contract is a
      new package (api.v2) next to the old one.

        mvn install    target/ext-catalog-api-<version>.jar, then the catalog and the fixtures of its
                       tests build against it
    -->
    <groupId>io.github.mosaikit.ext</groupId>
    <artifactId>ext-catalog-api</artifactId>
    <version>1.2.0</version>
    <name>Catalog API</name>
    <description>The contracts of the catalog that other extensions implement: kinds of files (EXT-105), with links to their content (EXT-107), and documents linked to resources of other extensions (EXT-006).</description>
    <url>https://github.com/mosaikit/mosaikit-ext/tree/main/ext-catalog/api</url>
    <licenses>
        <license>
            <name>MPL-2.0</name>
            <url>https://mozilla.org/MPL/2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/mosaikit/mosaikit-ext</url>
        <connection>scm:git:https://github.com/mosaikit/mosaikit-ext.git</connection>
        <developerConnection>scm:git:git@github.com:mosaikit/mosaikit-ext.git</developerConnection>
    </scm>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The Mosaikit whose extension API the contracts build on (@Contract, MK-134). -->
        <mosaikit.version>0.1.0-SNAPSHOT</mosaikit.version>
        <!-- A reproducible JAR: the manifests of the extensions that bring it name its digest (MK-131). -->
        <project.build.outputTimestamp>2026-10-15T00:00:00Z</project.build.outputTimestamp>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.mosaikit</groupId>
            <artifactId>mosaikit-kernel-api</artifactId>
            <version>${mosaikit.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <!-- The kernel finds the interfaces of the contracts in this index. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
