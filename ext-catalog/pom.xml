<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      A project of its own (ADR-0001): its parent is the published parent of Mosaikit extensions, never a
      POM of this repository (hence the empty relativePath).

        mvn package    lib/ext-catalog.jar and target/ext-catalog-0.1.0.zip, the package of the extension
        mvn verify     also the tests of tests/ on the bench of @mosaikit/testing (npm test)

      The Java code compiles against the API of the kernel and the Quarkus extensions the kernel already
      contains, all with scope provided: the JAR in lib/ holds only the classes of the extension.
    -->
    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-extension-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <groupId>io.github.mosaikit.ext</groupId>
    <artifactId>ext-catalog</artifactId>
    <version>0.1.0</version>
    <name>Catalog</name>
    <description>The file manager of an organization, with folders, sub-folders and sharing.</description>
    <url>https://github.com/mosaikit/mosaikit-ext/tree/main/ext-catalog</url>
    <scm>
        <url>https://github.com/mosaikit/mosaikit-ext</url>
        <connection>scm:git:https://github.com/mosaikit/mosaikit-ext.git</connection>
        <developerConnection>scm:git:git@github.com:mosaikit/mosaikit-ext.git</developerConnection>
    </scm>
    <dependencies>
        <dependency>
            <groupId>io.github.mosaikit</groupId>
            <artifactId>mosaikit-kernel-api</artifactId>
        </dependency>
        <!-- The contracts of the catalog that other extensions implement (EXT-105, MK-134): a library of
             the extension, built from api/ (mvn -f api install), which the kernel loads once for the
             catalog and the extensions of its contracts. -->
        <dependency>
            <groupId>io.github.mosaikit.ext</groupId>
            <artifactId>ext-catalog-api</artifactId>
            <version>1.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
